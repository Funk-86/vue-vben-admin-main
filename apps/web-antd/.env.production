# 生产环境接口地址
# 前后端同域部署（Nginx 反代 /api）时使用相对路径：
VITE_GLOB_API_URL=/api

# 前后端分离部署时改为后端完整地址，例如：
# VITE_GLOB_API_URL=https://api.your-domain.com/api

VITE_BASE=/

# 静态资源托管建议 hash 模式，免 Nginx try_files 配置
VITE_ROUTER_HISTORY=hash

VITE_COMPRESS=gzip

VITE_PWA=false

VITE_INJECT_APP_LOADING=true

VITE_ARCHIVER=false
